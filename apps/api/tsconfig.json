{
  // Source project: type-checks `src`. Worker runtime globals (Request,
  // Response, ExecutionContext, ExportedHandler, ...) and the Env wiring come
  // from `src/worker-configuration.d.ts` (generated by `wrangler types`), which
  // is an ambient global .d.ts picked up by the "src" include — no `types`
  // entry needed. Test files use their own `test/tsconfig.json` so that
  // test-only types (`@cloudflare/vitest-pool-workers/types`, i.e. the
  // `cloudflare:test` module) don't leak into the Worker source scope.
  "extends": "../../tsconfig.base.json",
  "include": ["src"]
}
