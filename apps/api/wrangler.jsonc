{
  // After changing bindings in this file, run 'wrangler types' and commit the
  // regenerated src/worker-configuration.d.ts (it types both Env and Cloudflare.Env).
  "name": "thinkersjournal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  // The api has NO public route — the web Worker's service binding is its whole
  // surface (see src/index.ts and apps/web/src/lib/api.ts). Keep it off workers.dev.
  "workers_dev": false,
  // Dual Hyperdrive bindings over the same Postgres.
  //   HYPERDRIVE_FRESH  = cache-disabled (`--caching-disabled`) — used for ALL
  //     auth / session / permission / dup-email / verify / read-after-write
  //     reads. Hyperdrive never invalidates on write, so a cached auth/verify
  //     read is a real security bug.
  //   HYPERDRIVE_CACHED = 60s cache — ONLY public feeds/listings.
  // The `id`s below are the LIVE Hyperdrive configs, created at first deploy
  // (2026-08-08): `tj-hyperdrive-cached` and `tj-hyperdrive-fresh`
  // (`--caching-disabled`), both over the same Neon Postgres.
  // Local tests resolve both bindings to the test DB via `miniflare.hyperdrives`
  // in vitest.config.ts, so these ids are never dereferenced in tests.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "8e0f6c638c1941e880ecceb802041e60"
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "0c47794783ec473bbbf7b4769fe0c98f"
    }
  ],
  // Opaque session tokens keyed by `sess:<sha256hex(token)>` (see src/auth/session.ts).
  // The `id` below is the LIVE KV namespace (created at first deploy 2026-08-08).
  //
  // FOLLOWEES (M2 followee-cache) — each viewer's followee-id list keyed by
  // `followees:<userId>`, a cache-aside layer over the follow graph (see
  // src/social/followee-cache.ts). The id below is the LIVE namespace.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "54a738c5fe30458ab2980260a88b3e79"
    },
    {
      "binding": "FOLLOWEES",
      "id": "12b22c01a86249569d67e91f6b4758d0"
    }
  ],
  // Cloudflare Images. NO zone, NO Images subscription, NO base fee — it is a
  // per-Worker binding (GA since Feb 2025). 5,000 free unique transforms/mo,
  // then $0.50/1k, billed once per unique (source+params) per calendar month.
  // `.info()` is FREE.
  // ⚠️ SVG IS A SUPPORTED INPUT — this binding will NOT reject it. The magic-byte
  // allowlist in src/media/sniff.ts is the SVG defense, not this.
  "images": { "binding": "IMAGES" },
  // Transformed WebP bytes, content-addressed on the OUTPUT hash. Served to the
  // public from the `cdn.thinkersjournal.com` R2 CUSTOM DOMAIN — deliberately
  // NOT through a Worker, which would add an invocation per image to buy authz
  // we do not need on a public CDN. Egress $0.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tj-media" }],
  // Per-user monotonic "security epoch" counter (logout-all / password-change
  // revocation, Tasks 16-17). New DO namespaces must use `new_sqlite_classes`
  // (KV-backed `new_classes` is blocked for new namespaces as of July 2026);
  // the migration `tag` is mandatory or the first dev/test run fails.
  //
  // NOTIFY (M2.3b) — a per-user WebSocket relay (`NotifyDO`) for the realtime
  // notification bell. Holds hibernating sockets and pushes content-free
  // nudges; no durable state, but `new_sqlite_classes` is still mandatory for a
  // new namespace (KV-backed `new_classes` is blocked). Added in the Task-0
  // connectivity spike — see docs/superpowers/spikes/2026-07-25-ws-topology-spike.md.
  //
  // POST_LIVE (M2.3b-live) — a per-post WebSocket relay (`PostLiveDO`) that
  // makes a post page update live when someone comments/reacts. UNAUTHED at
  // the route (any viewer of a public post may subscribe); content-free
  // relay, same shape as NOTIFY but keyed by postId instead of userId.
  "durable_objects": {
    "bindings": [
      { "name": "USER_SECURITY", "class_name": "UserSecurityDO" },
      { "name": "NOTIFY", "class_name": "NotifyDO" },
      { "name": "POST_LIVE", "class_name": "PostLiveDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserSecurityDO"] },
    { "tag": "v2", "new_sqlite_classes": ["NotifyDO"] },
    { "tag": "v3", "new_sqlite_classes": ["PostLiveDO"] }
  ],
  // ⚠️ THE PURGE HOP — api CANNOT purge web's cache.
  // Workers Cache purge is scoped to the Worker+entrypoint that OWNS the cache:
  // "a Worker cannot reach into another Worker's cache." Edits land HERE; the
  // rendered HTML lives in `web`'s cache. So this Worker asks `web` to purge, and
  // `web` calls context.cache.invalidate() inside its own entrypoint — the only
  // scope in which that call means anything. See src/cache/purge.ts.
  //
  // ⚠️ THIS MAKES THE SERVICE BINDINGS CIRCULAR (web -> api for everything, api
  // -> web for purge). Fine at runtime; a FIRST-DEPLOY chicken-and-egg, because
  // `wrangler deploy` resolves the target service by name and neither exists yet.
  // Order: deploy api WITHOUT this block -> deploy web -> add this block ->
  // redeploy api. Every later deploy is order-independent. See README.md's gate.
  "services": [{ "binding": "WEB", "service": "thinkersjournal-web" }],
  // Brute-force defense for signup/login (see src/auth/ratelimit.ts). This is a
  // TOP-LEVEL wrangler key (not `unsafe.bindings` — that shape is stale/legacy).
  // NOTE: the key is the PLURAL "ratelimits" — verified against the installed
  // wrangler 4.110.0's config schema (validateRateLimitBinding /
  // normalizeAndValidateConfig in wrangler-dist/cli.js), which registers this
  // field as `ratelimits` and rejects singular "ratelimit" with "Unexpected
  // fields found in top-level field: 'ratelimit'". `period` MUST be `10` or
  // `60`; no other value is accepted (enforced by the same validator).
  // `namespace_id` just needs to be unique per binding within this Worker
  // (arbitrary small strings are fine — Cloudflare doesn't provision anything
  // from it for the `simple` algorithm).
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    // Bounds an authenticated, verified account's upload rate. Keyed on the
    // SESSION's user (see src/routes/media.ts) — not an IP, which an attacker
    // can rotate. This is quota-adjacent, so it is consumed only by a request
    // already entitled to proceed.
    {
      "name": "MEDIA_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    // Bounds `POST /auth/resend-verification` (see src/routes/resend-verification.ts).
    // Keyed on the SESSION's user, same reasoning as MEDIA_LIMITER — the caller
    // is always authenticated by the time this is consumed. Tighter than the
    // others: this is a real mail SEND (Postmark cost + our sender reputation),
    // not just a DB/CPU cost.
    {
      "name": "RESEND_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 3, "period": 60 }
    },
    // Bounds `POST /follows` (see src/routes/follows.ts). Keyed on the SESSION's
    // user, same reasoning as MEDIA_LIMITER/RESEND_LIMITER — the caller is always
    // authenticated (and verified) by the time this is consumed.
    {
      "name": "FOLLOW_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 }
    },
    // Bounds POST /comments (see src/routes/comments.ts). Session-user-keyed,
    // same reasoning as FOLLOW_LIMITER. Comments are heavier rows than follows
    // (10k body + a purge per write) — tighter limit.
    {
      "name": "COMMENT_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 }
    },
    // Bounds POST/DELETE /reactions (Task 6 — added now so wrangler types runs once).
    // Toggles are cheap and bursty (a reader reacting down a thread) — looser.
    {
      "name": "REACTION_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Email outbox drains (M2.3c) — api's FIRST cron. */2 = instant pass; the daily
  // 14:00 UTC = digest pass. src/index.ts's scheduled() branches on controller.cron.
  //
  // 03:30 UTC = the unverified-account reaper (handle-at-signup Task 8) — hard-
  // deletes accounts that never verified within 7 days, freeing squatted
  // handles + emails. See src/auth/reap-unverified.ts. Its own explicit branch
  // in scheduled(), checked BEFORE the digest/instant dispatch above.
  //
  // 04:15 UTC = the orphan-media reclaimer (content-deletion + media-
  // reclamation, Task 4) — frees `media` rows (and, dedup-safely, their R2
  // objects) referenced by no post. See src/media/reap-orphan-media.ts. Its
  // own explicit branch in scheduled(), checked AFTER the unverified-account
  // reaper's above and BEFORE the digest/instant dispatch.
  "triggers": { "crons": ["*/2 * * * *", "0 14 * * *", "30 3 * * *", "15 4 * * *"] },
  "observability": {
    "enabled": true
  }
}
