{
  // Node test project: type-checks the DB migration test (`*.db.test.ts`), the
  // config-source tests (`*.node.test.ts`) and the migration globalSetup
  // (`global-setup.ts`). These run in a plain Node environment — NOT in workerd —
  // so they use Node types (`process.env`, `node:fs`, `node:url`) and the `pg` /
  // `node-pg-migrate` / `jsonc-parser` module types, kept separate from the
  // workerd `cloudflare:test` scope.
  //
  // ⚠️ `*.node.test.ts` exists because workerd's filesystem is VIRTUAL (`/bundle`),
  // so a pool test cannot read this repo's own config files. See vitest.config.ts.
  //
  // `allowJs` (#116): check-migrations-applied.node.test.ts imports the pure
  // pieces straight out of the repo-root `scripts/check-migrations-applied.mjs`
  // (same precedent as apps/web/test/turnstile-build-guard.node.test.ts
  // importing its sibling `.mjs` — that package's tsconfig gets `allowJs` for
  // free from `astro/tsconfigs/strict`; this base does not, so it is set here
  // explicitly). Without it, TS7016 ("could not find a declaration file")
  // blocks the import outright, and this script is deliberately plain
  // dependency-free ESM, never a `.ts` file, per its own header.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true
  },
  "include": ["./**/*.db.test.ts", "./**/*.node.test.ts", "./global-setup.ts"]
}
