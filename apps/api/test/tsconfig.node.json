{
  // Node test project: type-checks the DB migration test (`*.db.test.ts`), the
  // config-source tests (`*.node.test.ts`) and the migration globalSetup
  // (`global-setup.ts`). These run in a plain Node environment — NOT in workerd —
  // so they use Node types (`process.env`, `node:fs`, `node:url`) and the `pg` /
  // `node-pg-migrate` / `jsonc-parser` module types, kept separate from the
  // workerd `cloudflare:test` scope.
  //
  // ⚠️ `*.node.test.ts` exists because workerd's filesystem is VIRTUAL (`/bundle`),
  // so a pool test cannot read this repo's own config files. See vitest.config.ts.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["./**/*.db.test.ts", "./**/*.node.test.ts", "./global-setup.ts"]
}
