{
  "name": "@thinkersjournal/web",
  "version": "0.1.14",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "//build": "Never 'astro build' directly. build-web.mjs is what cleans dist (astro.config.mjs disables astro's own broken emptyDir via vite.build.emptyOutDir=false) and reaps the workerd processes astro leaks, which would lock dist and break the NEXT build. See that script's header.",
    "build": "node ../../scripts/build-web.mjs",
    "test": "vitest run",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@thinkersjournal/markdown": "workspace:*",
    "@thinkersjournal/shared": "workspace:*",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "fast-xml-parser": "5.11.2",
    "jsonc-parser": "3.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
