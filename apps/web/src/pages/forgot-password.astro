---
/**
 * `POST /auth/forgot-password` through the Service Binding (#70).
 *
 * Same server-side form-post-to-self shape as login.astro/signup.astro — no
 * client `fetch`, keeping the api unreachable from the browser directly.
 *
 * ⚠️ THE RESPONSE IS ALWAYS THE SAME MESSAGE, whether or not the submitted
 * address is registered — that is this route's whole design (see
 * apps/api/src/routes/forgot-password.ts's header). Do NOT branch this
 * page's copy on the api's response beyond status/network-failure handling:
 * doing so would re-introduce, at the UI layer, exactly the enumeration leak
 * the api goes out of its way to avoid at the wire layer.
 */
import BaseLayout from "../components/BaseLayout.astro";
import { apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

// Per-viewer, like login/signup: this page's own render carries no session
// state, but it is a same-shape anonymous form that must never be cached —
// see src/lib/cache.ts.
markPrivate(Astro);

// `{ turnstile: true }`, same reason as signup.astro: this is another
// anonymous form that can trigger mail to an attacker-chosen address, so it
// gets the same bot-defense widget and CSP widening for its host.
setPublicPageCsp(Astro, { turnstile: true });

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

/** `null` = first visit. `"sent"` is the ONLY other state — see the header. */
let result: "sent" | null = null;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const response = await apiFetch("/auth/forgot-password", {
    method: "POST",
    body: {
      email: form.get("email"),
      turnstileToken: form.get("turnstileToken"),
    },
    // ⚠️ The BROWSER's Origin, forwarded verbatim — same reasoning as
    // login/signup: this route has no session, so `checkOrigin` is its
    // entire CSRF defense.
    origin: Astro.request.headers.get("Origin") ?? "",
  });
  applyCookies(Astro.response.headers, response.setCookies);

  if (response.status === 202) {
    result = "sent";
  } else if (response.status === 429) {
    error = "Too many attempts. Please wait and try again.";
  } else if (response.status === 403) {
    error = "Rejected (failed bot check).";
  } else {
    // 400 (malformed email) is the only other realistic case — the api
    // never distinguishes "not registered" here. Same generic copy either
    // way, deliberately: see the file header.
    error = "Something went wrong. Check your email address and try again.";
  }
}
---

<BaseLayout title="Forgot password" description="Reset your Thinker's Journal password.">
  <div class="wrap form-page">
    <h1>Forgot password</h1>

    {
      result === "sent" ? (
        <p id="sent">
          If that email is registered, we've sent a link to reset your password. It expires in 1 hour.
        </p>
      ) : (
        <>
          <p class="intro">Enter your email and we'll send you a link to choose a new password.</p>
          {error !== null && <p id="error" role="alert">{error}</p>}
          <form method="POST" class="form">
            <label>
              Email
              <input type="email" name="email" required />
            </label>
            {/* Same Turnstile widget as signup.astro — see its own comment
                for the production-vs-dev/e2e split. */}
            {
              turnstileSiteKey ? (
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-response-field-name="turnstileToken"
                ></div>
              ) : (
                <input type="text" name="turnstileToken" value="dummy-token" />
              )
            }
            <button type="submit" class="btn btn-primary">Send reset link</button>
          </form>
          {
            turnstileSiteKey && (
              <>
                {/* NO Subresource Integrity, deliberately — same reasoning as
                    signup.astro's identical script tag: Turnstile's api.js is
                    a Cloudflare-updated, versionless LOADER, so a pinned
                    `integrity` hash would break the widget the moment
                    Cloudflare updates it (SRI is not supported on this
                    endpoint). The integrity control is the CSP instead:
                    script-src is allowlisted to challenges.cloudflare.com
                    only (setPublicPageCsp's `{ turnstile: true }` policy). */}
                <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
              </>
            )
          }
        </>
      )
    }

    <p><a class="link" href="/login">Back to log in</a></p>
  </div>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:440px}
  .intro{color:var(--muted);margin:0 0 20px}
  .form{display:flex;flex-direction:column;gap:16px;margin:24px 0}
  .form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .form input{background:var(--ink2);border:1px solid var(--line);border-radius:8px;
    padding:11px 13px;color:var(--text);font:inherit}
  .form input:focus-visible{border-color:var(--green)}
</style>
