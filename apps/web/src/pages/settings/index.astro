---
/**
 * `/settings` — the landing page for the settings area, replacing the old
 * stop-gap where nav-auth.ts pointed "Settings" straight at
 * /settings/notifications (the only one of the three with an inbound link).
 * Lists all three sections with a one-line description each.
 *
 * Auth handling mirrors settings/account.astro and settings/blocked.astro
 * exactly (both read a real session): authed + never cached (markPrivate),
 * redirect to /login with no session. settings/notifications.astro agrees —
 * all three use the identical `if (csrfToken === null) return
 * Astro.redirect("/login")` check, so there is no disagreement to resolve
 * here.
 */
import BaseLayout from "../../components/BaseLayout.astro";
import SettingsNav from "../../components/SettingsNav.astro";
import { apiFetch } from "../../lib/api";
import { markPrivate } from "../../lib/cache";
import { setPublicPageCsp } from "../../lib/csp";

markPrivate(Astro);
setPublicPageCsp(Astro);

const csrf = await apiFetch<{ csrfToken: string }>("/auth/csrf", { request: Astro.request });
const csrfToken = csrf.status === 200 ? (csrf.data?.csrfToken ?? null) : null;
if (csrfToken === null) return Astro.redirect("/login");
---
<BaseLayout title="Settings">
  <div class="wrap form-page">
    <h1>Settings</h1>
    <SettingsNav />
    <ul class="sections">
      <li>
        <h2><a class="link" href="/settings/notifications">Notification emails</a></h2>
        <p class="hint">Choose which emails you get for comments, reactions, and new followers.</p>
      </li>
      <li>
        <h2><a class="link" href="/settings/blocked">Blocked users</a></h2>
        <p class="hint">See and manage who you've blocked.</p>
      </li>
      <li>
        <h2><a class="link" href="/settings/account">Account</a></h2>
        <p class="hint">Request or cancel account deletion.</p>
      </li>
    </ul>
  </div>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:560px}
  .sections{list-style:none;display:flex;flex-direction:column;gap:20px;margin-top:8px}
  .sections li{padding:16px;border:1px solid var(--line);border-radius:8px}
  .hint{color:var(--muted);font-size:14px;margin-top:6px}
</style>
