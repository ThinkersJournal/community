---
/**
 * The Markdown editor — create (`/new-post`) and edit (`/new-post?post=<id>`).
 *
 * ONE page for both: two pages would be two copies of the same form and the
 * same submit logic, drifting from the day the second was written.
 *
 * ⚠️ PREVIEW IS SERVER-SIDE, through the SAME `renderMarkdown` the public post
 * page (`[handle]/[slug].astro`) uses. That is not a shortcut — it is the
 * point: the preview is not an approximation of the post, it IS the post, with
 * zero extra JS shipped and no second renderer to drift out of sync with the
 * sanitizer. It also costs nothing extra in bundle size: this Worker already
 * bundles `@thinkersjournal/markdown` (Shiki included) to render the public
 * post page, so importing it here does not add a byte to what `web` ships —
 * see the task report for the tradeoff this decision avoided (bundling the
 * pipeline into the BROWSER would have cost ~2MB of Shiki on an authed,
 * uncached page).
 *
 * ⚠️ HOW THE CSRF TOKEN GETS HERE (unchanged from M0 — do not simplify). The
 * api requires `X-CSRF-Token` = `sha256Hex(session.csrfSecret)` on every
 * mutating request. `csrfSecret` lives only in the api's KV session record, so
 * THIS Worker cannot compute it — it fetches it from `GET /auth/csrf`
 * (apps/api/src/routes/csrf.ts) over the Service Binding, forwarding the
 * browser's session cookie, and embeds it below as a hidden input.
 *
 * ⚠️ WHY A HIDDEN INPUT AND NOT A COOKIE. A non-HttpOnly cookie would be
 * readable by any injected script AND would ride along on cross-site requests
 * automatically — precisely the property the double-submit exists to deny.
 * Rendered into the page body, the token is reachable only by someone who
 * could already read an authenticated response from this origin.
 *
 * ⚠️ WHY THE FORM POSTS TO THIS PAGE RATHER THAN TO THE API. An HTML form
 * cannot set a request HEADER — there is no markup for it — so a form could
 * never satisfy `X-CSRF-Token`, and the api accepts the token in NO other
 * place (by design: a header is exactly what a cross-site form cannot forge).
 * So the form posts back here same-origin, and this component promotes the
 * hidden field to a real header on the Service-Binding call.
 */
import { renderMarkdown } from "@thinkersjournal/markdown";
import type { AuthoredPost } from "@thinkersjournal/shared";

import BaseLayout from "../components/BaseLayout.astro";
import { apiErrorCode, apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

// ⚠️ Per-session secrets (the CSRF token below) and unpublished text are
// rendered here — never let a shared cache hold this. Cookie is NOT in the
// Workers Cache key and does NOT trigger a bypass, so a cacheable render here
// would hand one viewer's CSRF token — and another's draft — to everyone else.
markPrivate(Astro);

// Now carries the shared nav island + fonts (BaseLayout, below), and a real
// CSP: `script-src 'self'` (setPublicPageCsp's policy), no `'unsafe-inline'`.
// Safe ONLY because the media-upload island below is a BUNDLED import
// (src/scripts/media-upload.ts), not the inline `<script type="module">`
// this page used to carry — an inline script with no `import` would have
// been silently blocked by this exact directive. See media-upload.ts's
// header for the full story.
setPublicPageCsp(Astro);

type Outcome = "saved" | "published" | "unauthenticated" | "unverified" | "error" | null;
let outcome: Outcome = null;
let message = "";
let previewHtml: string | null = null;

// ⚠️ The BROWSER's Origin, forwarded verbatim — never this app's own, which
// would launder a cross-site request into an allowlisted one. See
// src/lib/api.ts's `origin` doc comment for the login-CSRF incident this
// guards against (Task 18); the same laundering here would reopen it for
// post authoring.
const origin = Astro.request.headers.get("Origin") ?? "";

/**
 * Fetch the CSRF token for the caller's session on EVERY render — GET and the
 * re-render after a POST alike — so the freshly-rendered form always carries a
 * token matching the CURRENT session (after logout-all + re-login, a stale one
 * would 403). 401 here simply means "not logged in": a normal state, not a
 * failure.
 */
const csrf = await apiFetch<{ csrfToken: string }>("/auth/csrf", { request: Astro.request });
const csrfToken = csrf.status === 200 ? (csrf.data?.csrfToken ?? null) : null;

let postId = Astro.url.searchParams.get("post");
let title = "";
let markdownSource = "";
let tagsValue = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "draft");
  title = String(form.get("title") ?? "");
  markdownSource = String(form.get("markdownSource") ?? "");
  postId = String(form.get("postId") ?? "") || null;
  // ⚠️ The server (apps/api/src/routes/posts.ts) is the authority on tag
  // validation — slugify, dedupe, per-label max length, the 400 for a label
  // that is too long. THIS split/trim/cap is not a second validator; it is
  // just what a plain comma-separated `<input>` needs to become an array
  // before it reaches `apiFetch`'s JSON body. A too-long label is still the
  // api's 400 to return.
  const tagsRaw = String(form.get("tags") ?? "");
  const tags = tagsRaw
    .split(",")
    .map((t) => t.trim())
    .filter((t) => t.length > 0)
    .slice(0, 5);
  // Re-render the user's raw input verbatim on a failed submit — never the
  // re-derived `tags` array, which would silently drop whitespace/dupes the
  // author typed before they've even seen the error.
  tagsValue = tagsRaw;
  const submittedToken = String(form.get("csrfToken") ?? "");

  if (intent === "preview") {
    // ⚠️ REQUIRES A SESSION, DELIBERATELY NARROWER THAN "pure render, no auth
    // needed" might suggest. It IS a pure render — no api call, no mutation,
    // and NOT gated on email verification (an unverified author must still be
    // able to preview a draft before they can verify). But with no gate at
    // all, this branch is a free, unauthenticated "run Shiki over arbitrary
    // text" oracle: `renderMarkdown` runs the full sanitize+highlight pipeline
    // on whatever a POST body contains, and nothing before this line checks
    // WHO is asking. The public post page pays the same cost only for content
    // that already cleared signup + email verification to exist; this closes
    // the same gap for the editor's preview.
    if (csrfToken === null) {
      outcome = "unauthenticated";
    } else {
      previewHtml = await renderMarkdown(markdownSource);
    }
  } else {
    const status = intent === "publish" ? "published" : "draft";
    interface SavedPost {
      id: string;
      slug: string;
      status: string;
      // Only present so a successful PUBLISH can redirect to `/@user/slug`
      // without a second round trip — see apps/api/src/routes/posts.ts's
      // `usernameFor`.
      username: string;
    }
    const response =
      postId === null
        ? await apiFetch<SavedPost>("/posts", {
            method: "POST",
            // ⚠️ `markdownSource`, matching the api's `CreatePostInput`
            // (packages/shared/src/posts.ts) — clean Markdown, the single
            // source of truth, rendered at READ time.
            body: { title, markdownSource, status, tags },
            // Forwards the session cookie — the api resolves the session from
            // it and recomputes the expected token to compare against the
            // header below.
            request: Astro.request,
            origin,
            // The hidden input, promoted back into the header the api demands.
            csrfToken: submittedToken,
          })
        : await apiFetch<SavedPost>(`/posts/${encodeURIComponent(postId)}`, {
            method: "PATCH",
            body: { title, markdownSource, status, tags },
            request: Astro.request,
            origin,
            csrfToken: submittedToken,
          });

    const succeeded = response.status === 201 || response.status === 200;

    if (succeeded && status === "published" && response.data !== null) {
      // ⚠️ DO NOT REPLACE THIS WITH `Astro.redirect(...)`. That helper builds a
      // response it owns ITSELF, which does not carry `Astro.response.headers`
      // — the api's `Set-Cookie` (if any rides on this response) would be
      // silently dropped on the very response that navigates the browser away.
      // login.astro hit exactly this bug first (see its identical warning);
      // building the redirect by hand and applying cookies to IT is the fix.
      const redirect = new Response(null, {
        status: 302,
        // A RELATIVE path, deliberately — NOT src/lib/canonical.ts's
        // `postUrl()`. That helper is correct for an OG/canonical tag (a
        // constant production origin, because host is not in the Workers
        // Cache key) but wrong here: a redirect must land the browser back on
        // THIS origin (localhost in dev, the real domain in prod), and a
        // relative `Location` does exactly that without hardcoding either.
        headers: { Location: `/@${response.data.username}/${response.data.slug}` },
      });
      applyCookies(redirect.headers, response.setCookies);
      return redirect;
    }

    if (succeeded && status === "draft" && response.data !== null) {
      // ⚠️ POST/REDIRECT/GET, same reasoning as the publish branch above — and
      // discovered by hand-testing Step 5's own checklist ("the URL keeps
      // ?post=<id> on reload"): a PLAIN FORM POST re-renders the SAME url
      // (`/new-post`, no query string), so without this the address bar never
      // gains `?post=`, a reload re-submits the form instead of re-fetching
      // (the browser's "confirm resubmission" prompt), and there is no
      // shareable/bookmarkable url back to this exact draft. `saved=1` is a
      // one-shot flag the GET branch below reads to show "Draft saved." on
      // the very next render, then never again on a plain reload.
      const redirect = new Response(null, {
        status: 302,
        headers: { Location: `/new-post?post=${encodeURIComponent(response.data.id)}&saved=1` },
      });
      applyCookies(redirect.headers, response.setCookies);
      return redirect;
    }

    // Every other outcome re-renders THIS page, so `Astro.response` IS the
    // outgoing response — an error/401/unverified, or the defensive case
    // where the api answered SUCCESS with no parseable body (neither redirect
    // above could fire without `response.data`).
    //
    // ⚠️ LOAD-BEARING ON THE 401 PATH. The api's pipeline answers a
    // REVOKED/stale session with 401 **plus a cleared cookie** (checkSecurityEpoch
    // in apps/api/src/auth/pipeline.ts) — dropping this leaves the dead cookie
    // in the browser, so the user is stuck re-sending a session that can only
    // ever 401 again instead of being cleanly logged out.
    applyCookies(Astro.response.headers, response.setCookies);

    if (succeeded) {
      postId = response.data?.id ?? postId;
      outcome = status === "published" ? "published" : "saved";
    } else if (response.status === 401) {
      outcome = "unauthenticated";
    } else if (apiErrorCode(response) === "EMAIL_NOT_VERIFIED") {
      // The soft gate: authenticated, but content mutation needs a verified
      // address. Distinct from a CSRF/origin 403, which shares the status.
      outcome = "unverified";
    } else {
      outcome = "error";
      message = `Could not save (status ${response.status}).`;
    }
  }
}

// Load an existing post for editing. AFTER the POST branch so a just-created
// post's id is honoured, and only for a GET — a POST already has the text
// (from the form, for every intent including preview).
if (postId !== null && Astro.request.method === "GET") {
  const existing = await apiFetch<AuthoredPost>(`/posts/${encodeURIComponent(postId)}`, {
    request: Astro.request,
  });
  if (existing.status === 200 && existing.data !== null) {
    title = existing.data.title;
    markdownSource = existing.data.markdownSource;
    tagsValue = existing.data.tags.map((t) => t.label).join(", ");
    // The one-shot flag the draft-save redirect above appends. Read here
    // rather than persisted anywhere: reloading this exact URL keeps showing
    // it (harmless — it is still true that the draft was saved), but
    // navigating anywhere else drops it naturally, with no state to clean up.
    if (Astro.url.searchParams.get("saved") === "1") {
      outcome = "saved";
    }
  } else {
    // 404 covers "not yours" too — the api never distinguishes them.
    return new Response(null, { status: 404 });
  }
}

const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<BaseLayout title={postId === null ? "New post" : "Edit post"}>
  <div class="wrap form-page">
    <h1>{postId === null ? "New post" : "Edit post"}</h1>

    {outcome === "saved" && <p id="saved">Draft saved.</p>}
    {outcome === "published" && <p id="published">Published.</p>}
    {outcome === "unverified" && <p id="unverified">Please verify your email address before posting.</p>}
    {outcome === "unauthenticated" && <p id="session-expired">Your session has expired. Please log in again.</p>}
    {outcome === "error" && <p id="error">{message}</p>}

    {
      csrfToken === null ? (
        <p id="login-required">
          <a class="link" href={loginHref}>Log in to write a post</a>
        </p>
      ) : (
        <form method="POST" id="editor-form" class="form">
          {/* The api's per-session CSRF token, promoted to the X-CSRF-Token
              header server-side on submit (see the frontmatter) — a form
              cannot set a header itself. */}
          <input type="hidden" name="csrfToken" value={csrfToken} />
          <input type="hidden" name="postId" value={postId ?? ""} />
          <label>
            Title
            <input type="text" id="title" name="title" value={title} required />
          </label>
          <label>
            Body (Markdown)
            <textarea id="markdownSource" name="markdownSource" rows="24" required>{markdownSource}</textarea>
          </label>
          <label>
            Tags (comma-separated, up to 5)
            <input type="text" id="tags" name="tags" value={tagsValue} placeholder="rust, web-dev" />
          </label>

          <fieldset>
            <legend>Insert an image</legend>
            {/* NOT inside a nested form — HTML forbids that. The island below
                uploads it with fetch() and writes the Markdown into the
                textarea. */}
            <input type="file" id="media-file" accept="image/jpeg,image/png,image/gif,image/webp" />
            <p id="media-status" role="status" />
          </fieldset>

          <div class="actions">
            <button type="submit" name="intent" value="preview" class="btn btn-ghost">Preview</button>
            <button type="submit" name="intent" value="draft" class="btn btn-ghost">Save draft</button>
            <button type="submit" name="intent" value="publish" class="btn btn-primary">Publish</button>
          </div>
        </form>
      )
    }

    {
      previewHtml !== null && (
        <section id="preview">
          <h2>Preview</h2>
          {/* Safe for the SAME one reason as the public page: this string came
              out of packages/markdown, whose LAST UNSAFE THING is
              rehype-sanitize. And it is the same function, so what you see IS
              what publishes. */}
          <div id="preview-body" set:html={previewHtml} />
        </section>
      )
    }
  </div>

  <script>
    // The media-upload island. An `import`, deliberately — that is what makes
    // Astro externalize this to a bundled `/_astro/*.js` module instead of
    // leaving it inline (see media-upload.ts's header and setPublicPageCsp
    // above, which would otherwise block an inline script outright).
    import { initMediaUpload } from "../scripts/media-upload";
    initMediaUpload();
  </script>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:760px}
  .form{display:flex;flex-direction:column;gap:16px;margin:24px 0}
  .form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .form input[type="text"],
  .form textarea{background:var(--ink2);border:1px solid var(--line);border-radius:8px;
    padding:11px 13px;color:var(--text);font:inherit}
  .form input:focus-visible,
  .form textarea:focus-visible{border-color:var(--green)}
  .form fieldset{border:1px solid var(--line);border-radius:8px;padding:16px;
    display:flex;flex-direction:column;gap:8px}
  .form legend{color:var(--muted);font-size:14px;padding:0 6px}
  .actions{display:flex;gap:12px;flex-wrap:wrap}
</style>
