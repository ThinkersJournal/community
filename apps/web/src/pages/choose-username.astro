---
import BaseLayout from "../components/BaseLayout.astro";
import { apiErrorCode, apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";
import { resolveNext } from "../lib/next-url";

import type { ApiErrorCode, Me } from "@thinkersjournal/shared";

// Authed page — never cacheable. Declares exactly one cache helper.
markPrivate(Astro);

// Now carries the shared nav island + fonts (BaseLayout, below). No inline
// `<script>` on this page, so `script-src 'self'` (setPublicPageCsp's policy)
// is safe.
setPublicPageCsp(Astro);

// A CSRF token proves a live session; null means "not logged in".
const csrf = await apiFetch<{ csrfToken: string }>("/auth/csrf", { request: Astro.request });
const csrfToken = csrf.status === 200 ? (csrf.data?.csrfToken ?? null) : null;

/**
 * ⚠️ WHERE `next` SENDS A JUST-ONBOARDED USER BACK TO (milestone review —
 * the content-loss fix). new-post.astro links here with
 * `?next=/new-post` so an author who was gated out of the editor for not
 * having a handle yet returns to it — instead of always landing on /feed,
 * which would strand them with nothing to show for having onboarded.
 *
 * ⚠️ OPEN-REDIRECT GUARD, delegated to `resolveNext` (src/lib/next-url.ts) —
 * the SAME hardened, exhaustively-tested guard login.astro uses. Do NOT
 * hand-roll a check here again: a prior hand-rolled `isSafeLocalPath` (a
 * leading-`/`-and-no-`:` regex-style check) was bypassable via
 * `/\evil.com`, which browsers normalize to `//evil.com` (WHATWG URL), i.e.
 * a scheme-relative redirect straight off-origin. `resolveNext` runs the
 * browser's OWN URL parser against this page's URL and returns an ABSOLUTE
 * same-origin URL, degrading to this origin's home for anything not
 * provably same-origin — see that file for the full "why a regex can't do
 * this job" writeup and `test/next-url.test.ts` for the hostile corpus
 * (including this exact `/\evil.com` payload).
 *
 * `/feed` stays the default ONLY for "no `next` at all" — resolveNext's own
 * default is `origin + "/"`, but this page's pre-existing no-next default is
 * `/feed`, so that one case is special-cased before the call rather than
 * folded into resolveNext.
 */
const raw = Astro.url.searchParams.get("next");
const dest = raw === null ? "/feed" : resolveNext(raw, Astro.url);

let error: string | null = null;
// The raw error CODE (not just its message), so the template can conditionally
// render extra affordances per-code — e.g. the resend/verify link below,
// which no other error case gets.
let errorCode: ApiErrorCode | null = null;

// ⚠️ handle-at-signup Task 4: `POST /profile/username` (below) no longer
// exists on the api — a handle is chosen once, at signup. This page is
// leftover pending Task 5's deletion (docs/superpowers/plans/
// 2026-08-13-handle-at-signup.md); every real account already has a handle,
// so the "already onboarded, bounce away" probe this block used to run
// (`GET /profile/me` + `usernameChosen === true`) no longer has a field to
// check and was removed here rather than left to fail typecheck against the
// shared `Me` type, which dropped that field in the same task.
if (csrfToken !== null) {
  if (Astro.request.method === "POST") {
    const form = await Astro.request.formData();
    const username = String(form.get("username") ?? "");
    const submittedToken = String(form.get("csrfToken") ?? "");

    const response = await apiFetch<Me>("/profile/username", {
      method: "POST",
      body: { username },
      request: Astro.request,
      origin: Astro.request.headers.get("Origin") ?? "",
      csrfToken: submittedToken,
    });

    const responseCode = apiErrorCode(response);

    // ⚠️ `USERNAME_ALREADY_SET` no longer exists (Task 4 dropped it from
    // ApiErrorCode along with the route that emitted it) — the api answers
    // every POST here 404 now. `response.status === 200` alone is unreachable
    // in practice; this branch is inert leftover, not a live success path.
    if (response.status === 200) {
      // ⚠️ DO NOT REPLACE THIS WITH `Astro.redirect("/feed")`. That helper
      // builds a response it owns ITSELF, which does not carry
      // `Astro.response.headers` — the api's `Set-Cookie` (from this very
      // apiFetch call, just above) would be silently dropped on the response
      // that navigates the browser away. login.astro and new-post.astro hit
      // this exact bug first (see their identical warnings); building the
      // redirect by hand and applying cookies to IT is the fix.
      const redirect = new Response(null, {
        status: 302,
        headers: { Location: dest },
      });
      applyCookies(redirect.headers, response.setCookies);
      return redirect;
    }

    // Every other outcome re-renders THIS page, so `Astro.response` IS the
    // outgoing response.
    applyCookies(Astro.response.headers, response.setCookies);

    errorCode = responseCode;
    switch (responseCode) {
      case "USERNAME_TAKEN":
        error = "That handle is already taken — try another.";
        break;
      case "EMAIL_NOT_VERIFIED":
        error = "Please verify your email before choosing a handle.";
        break;
      default:
        error = "That handle isn’t valid. Use 3–30 lowercase letters, numbers, or underscores.";
    }
  }
}
---

<BaseLayout title="Choose your handle" description="Pick your permanent Thinker's Journal handle.">
  <div class="wrap form-page">
    <h1>Choose your handle</h1>
    {csrfToken === null ? (
      <p>You need to <a class="link" href="/login">log in</a> to choose a handle.</p>
    ) : (
      <>
        <p>Pick a permanent <code>@handle</code> — 3–30 lowercase letters, numbers, or underscores. This can’t be changed later.</p>
        {error && (
          <p id="error" role="alert">
            {error}
            {errorCode === "EMAIL_NOT_VERIFIED" && (
              <>
                {" "}
                <a class="link" href="/verify-email">Verify your email</a>
              </>
            )}
          </p>
        )}
        <form method="POST" class="form">
          <input type="hidden" name="csrfToken" value={csrfToken} />
          <label for="username">Handle</label>
          <input id="username" name="username" required minlength="3" maxlength="30"
                 pattern="[a-z0-9_]{3,30}" autocapitalize="none" autocomplete="off" />
          <button type="submit" class="btn btn-primary">Claim handle</button>
        </form>
      </>
    )}
  </div>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:440px}
  .form{display:flex;flex-direction:column;gap:16px;margin:24px 0}
  .form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .form input{background:var(--ink2);border:1px solid var(--line);border-radius:8px;
    padding:11px 13px;color:var(--text);font:inherit}
  .form input:focus-visible{border-color:var(--green)}
</style>
