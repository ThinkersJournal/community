---
/**
 * `GET /verify-email?token=…` through the Service Binding, PLUS
 * `POST /auth/resend-verification` for a logged-in user whose link was lost,
 * slow, or never arrived — see apps/api/src/routes/resend-verification.ts's
 * header for why that route exists and why it requires a session rather than
 * an email in the body (a `{email}` endpoint would be a mail-bombing gun aimed
 * at any address an attacker names, and an enumeration oracle).
 *
 * ⚠️ THE LOGIN_REQUIRED RIPPLE — the reason this page is not a one-liner.
 *
 * The api requires a valid, non-stale session belonging to the token's OWN user
 * before it will verify (see apps/api/src/routes/verify-email.ts — it closes an
 * account-takeover chain where clicking an emailed link would verify an account
 * whose password an attacker had since replaced). So the single most ORDINARY
 * path — a user clicks the link from their email client, in a browser with no
 * session — arrives here and gets a 401 `{"code":"LOGIN_REQUIRED"}`.
 *
 * That is not an error to report; it is a step in the flow. The api PEEKS at
 * the token rather than consuming it on every auth failure, precisely so the
 * link SURVIVES this rejection. So we tell the user to log in and send them
 * back to this exact URL (`?next=`), where the same token still works.
 *
 * ⚠️ THE RESEND FORM — same CSRF story as new-post.astro (see its header for
 * the full "why a hidden input and not a cookie" reasoning, repeated here in
 * brief): the api demands `X-CSRF-Token` = `sha256Hex(session.csrfSecret)`,
 * computable only from the KV session record, so THIS Worker cannot compute it
 * itself — it fetches it from `GET /auth/csrf` over the Service Binding and
 * embeds the result as a hidden input. A non-HttpOnly cookie would defeat the
 * whole point of a double-submit token (readable by an injected script, and
 * riding along on cross-site requests automatically); rendered into the page
 * body, the token is reachable only by someone who could already read an
 * authenticated response from this origin. An HTML form cannot set a request
 * HEADER either, so it posts back HERE (same origin, `action="/verify-email"`)
 * and this component promotes the hidden field to a real `X-CSRF-Token` header
 * on the Service-Binding call — that round trip is what makes it a genuine
 * double-submit, since a cross-site attacker can make the browser POST here but
 * cannot read the token out of the page to fill the field in.
 */
import { apiErrorCode, apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";

// ⚠️ Per-viewer: this page's own URL carries the verification token, and the
// rendered login link + hidden CSRF input both carry per-request secrets.
// Cookie is NOT in the Workers Cache key and does NOT trigger a bypass, so a
// cacheable render here would serve one user's verification outcome — and CSRF
// token — to everyone. See src/lib/cache.ts.
markPrivate(Astro);

const token = Astro.url.searchParams.get("token");

type Outcome = "verified" | "login-required" | "invalid" | "missing" | null;
let outcome: Outcome = null;

// Only the ORDINARY "click the emailed link" visit is a GET; the resend form
// below POSTs back to this same page and must not re-run the token check.
if (Astro.request.method === "GET") {
  if (token === null || token === "") {
    outcome = "missing";
  } else {
    const response = await apiFetch<{ code?: string }>(
      `/verify-email?token=${encodeURIComponent(token)}`,
      {
        // ⚠️ Load-bearing: forwards the browser's `Cookie` so the api can resolve
        // the session. Without it EVERY visit is a 401, including from a
        // logged-in user — the flow would be unusable.
        request: Astro.request,
      },
    );

    if (response.status === 200) {
      outcome = "verified";
    } else if (response.data?.code === "LOGIN_REQUIRED") {
      // 401 (no session / stale session) and 403 (token belongs to someone else)
      // share this code and an identical body — deliberately, so the api never
      // reveals whose token it is. Both mean the same thing to the user: sign in
      // as the account that owns this link, then re-open it.
      outcome = "login-required";
    } else {
      // A genuinely bad token: unknown, expired, or already redeemed. The api
      // returns one generic 400 for all three (it must not confirm that a guessed
      // token was ever real).
      outcome = "invalid";
    }
  }
}

/** What the resend form's submission produced, or `null` on a GET visit. */
type ResendOutcome = "sent" | "already-verified" | "unauthenticated" | "error" | null;
let resendOutcome: ResendOutcome = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const response = await apiFetch<{ code?: string }>("/auth/resend-verification", {
    method: "POST",
    // Forwards the session cookie — the api derives the address to mail from
    // `session.userId`, never from anything the form submits.
    request: Astro.request,
    // ⚠️ The BROWSER's Origin, forwarded verbatim — never this app's own, which
    // would launder a cross-site request into an allowlisted one. See
    // new-post.astro's identical note.
    origin: Astro.request.headers.get("Origin") ?? "",
    // The hidden input, promoted back into the header the api demands.
    csrfToken: String(form.get("csrfToken") ?? ""),
  });

  // ⚠️ LOAD-BEARING ON THE 401 PATH — the identical reasoning as
  // new-post.astro:74, and the reason that comment exists. The api's pipeline
  // answers a REVOKED/stale session with 401 **plus a cleared cookie** (step 4,
  // checkSecurityEpoch in apps/api/src/auth/pipeline.ts, which calls
  // `unauthorized({ "Set-Cookie": cookie })`). Dropping that header leaves the
  // dead cookie in the browser, so the user keeps re-sending a session that can
  // only ever 401 again instead of being cleanly logged out.
  //
  // This path is REACHABLE HERE, and narrowly so: `GET /auth/csrf` runs the epoch
  // check too (`readCurrentSession`), so an ALREADY-stale session renders no form
  // at all. The 401 below is specifically the session that died BETWEEN this page
  // rendering the form and the click — the "log out everywhere from another tab"
  // case named at the branch below. e2e/resend-verification.spec.ts constructs
  // exactly that window, and fails on the cookie alone if this call is removed.
  applyCookies(Astro.response.headers, response.setCookies);

  if (response.status === 202) {
    resendOutcome = "sent";
  } else if (apiErrorCode(response) === "ALREADY_VERIFIED") {
    // The api's honest answer for a session that already verified: nothing to
    // resend, and it leaks nothing here — the caller already IS that account.
    resendOutcome = "already-verified";
  } else if (response.status === 401) {
    // The session expired between this page rendering the form and the click —
    // e.g. "log out everywhere" from another tab. Send them to log back in.
    resendOutcome = "unauthenticated";
  } else {
    resendOutcome = "error";
  }
}

/**
 * Fetch the CSRF token for the caller's session. Done on EVERY render — the GET
 * visit and the re-render after a POST alike — so the freshly-rendered form
 * always carries a token matching the CURRENT session (after a logout-all +
 * re-login, a stale one would 403). Also what gates whether the resend form
 * renders at all: only a session holder has anything to resend.
 *
 * 401 here simply means "not logged in": there is no session, so there is no
 * token to issue. That is the ORDINARY state for a fresh emailed-link click,
 * not a failure.
 */
const csrf = await apiFetch<{ csrfToken: string }>("/auth/csrf", {
  request: Astro.request,
});
const csrfToken = csrf.status === 200 ? (csrf.data?.csrfToken ?? null) : null;

/**
 * Return here after logging in, token and all. Built from the CURRENT url's
 * path+query rather than reassembled, so the token survives verbatim.
 */
const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Verify email</title>
  </head>
  <body>
    <h1>Verify email</h1>

    {outcome === "verified" && <p id="verified">Your email is verified.</p>}

    {
      outcome === "login-required" && (
        <div id="login-required">
          <p>
            Please log in to verify this email address, then open the link from
            your email again. The link is still valid.
          </p>
          <p>
            <a href={loginHref}>Log in and continue</a>
          </p>
        </div>
      )
    }

    {
      outcome === "invalid" && (
        <p id="invalid">This verification link is invalid or has expired.</p>
      )
    }

    {outcome === "missing" && <p id="invalid">No verification token supplied.</p>}

    {resendOutcome === "sent" && <p id="resend-sent">We've sent another link.</p>}
    {
      resendOutcome === "already-verified" && (
        <p id="resend-already-verified">Your email is already verified.</p>
      )
    }
    {
      resendOutcome === "unauthenticated" && (
        <div id="resend-unauthenticated">
          <p>Your session has expired.</p>
          <p>
            <a href={loginHref}>Log in and continue</a>
          </p>
        </div>
      )
    }
    {
      resendOutcome === "error" && (
        <p id="resend-error">
          Could not send another link. Please try again in a minute.
        </p>
      )
    }

    {
      csrfToken !== null && (
        <form method="POST" action="/verify-email">
          {/*
            The api's per-session CSRF token. Promoted to the `X-CSRF-Token`
            header server-side on submit (see the frontmatter) — a form cannot
            set a header itself.
          */}
          <input type="hidden" name="csrfToken" value={csrfToken} />
          <button type="submit">Resend verification email</button>
        </form>
      )
    }
  </body>
</html>
