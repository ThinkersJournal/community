---
/**
 * `POST /auth/reset-password` through the Service Binding (#70) — redeems a
 * token from `forgot-password.astro`'s emailed link for a new password.
 *
 * Same server-side form-post-to-self shape as login.astro/signup.astro. The
 * token travels in `?token=` (the emailed link) and is carried forward as a
 * hidden field on the form, exactly like new-post.astro's `?post=` pattern
 * carries an id across its own POST re-render.
 */
import BaseLayout from "../components/BaseLayout.astro";
import { apiErrorCode, apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

// Per-viewer, like login/signup — this page mints a session on success (the
// api's Set-Cookie rides out on this very response). See src/lib/cache.ts.
markPrivate(Astro);

setPublicPageCsp(Astro);

const tokenFromLink = Astro.url.searchParams.get("token") ?? "";

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const token = String(form.get("token") ?? "");
  const password = String(form.get("password") ?? "");

  const response = await apiFetch("/auth/reset-password", {
    method: "POST",
    body: { token, password },
    // ⚠️ The BROWSER's Origin, forwarded verbatim — same reasoning as
    // login/signup/forgot-password: no session exists yet, so `checkOrigin`
    // is this route's entire CSRF defense.
    origin: Astro.request.headers.get("Origin") ?? "",
  });

  if (response.status === 200) {
    // ⚠️ DO NOT REPLACE WITH `Astro.redirect(...)` — same reasoning as
    // login.astro: that helper's response does not carry
    // `Astro.response.headers`, and the api's Set-Cookie (the new,
    // post-reset session) would be silently dropped.
    const redirect = new Response(null, { status: 302, headers: { Location: "/" } });
    applyCookies(redirect.headers, response.setCookies);
    return redirect;
  }

  applyCookies(Astro.response.headers, response.setCookies);

  error =
    apiErrorCode(response) === "INVALID_RESET_TOKEN"
      ? "This reset link is invalid or has expired. Request a new one."
      : response.status === 400
        ? "Choose a password with at least 12 characters."
        : "Something went wrong. Please try again.";
}
---

<BaseLayout title="Reset password" description="Choose a new Thinker's Journal password.">
  <div class="wrap form-page">
    <h1>Reset password</h1>

    {error !== null && <p id="error" role="alert">{error}</p>}

    <form method="POST" class="form">
      <input type="hidden" name="token" value={tokenFromLink} />
      <label>
        New password
        <input type="password" name="password" required minlength="12" />
      </label>
      <button type="submit" class="btn btn-primary">Set new password</button>
    </form>

    <p><a class="link" href="/forgot-password">Request a new link</a></p>
  </div>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:440px}
  .form{display:flex;flex-direction:column;gap:16px;margin:24px 0}
  .form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .form input{background:var(--ink2);border:1px solid var(--line);border-radius:8px;
    padding:11px 13px;color:var(--text);font:inherit}
  .form input:focus-visible{border-color:var(--green)}
</style>
