---
/**
 * `/admin/notices` — moderation notices that never got out (notice outbox PR 3):
 * every row in state `undeliverable`, with a Resend action. Same guard-first /
 * markPrivate / CSP shape as `admin/appeals.astro` and `admin/queue.astro` — see
 * those files' headers for the reasoning this page reuses.
 *
 * ⚠️⚠️ THE PROPERTY THIS FILE MUST NEVER LOSE: nothing about a notice (its
 * subject line, a handle) reaches the HTML on a request that does not carry a
 * verified Access JWT. The guard is the FIRST statement, before markPrivate,
 * before the CSP, before any api call.
 *
 * The page shows the SUBJECT and the account HANDLE only: never a notice body,
 * reason or address.
 */
import BaseLayout from "../../components/BaseLayout.astro";
import { adminApiErrorCode, adminApiFetch } from "../../lib/admin-api";
import { markPrivate } from "../../lib/cache";
import { setPublicPageCsp } from "../../lib/csp";

import { ACCESS_JWT_HEADER, type AdminUndeliveredNoticesResponse } from "@thinkersjournal/shared";

// ⚠️⚠️ THE GUARD — see this file's header. Nothing above this line does
// anything; nothing below it may run when this returns.
const accessJwt = Astro.request.headers.get(ACCESS_JWT_HEADER);
if (accessJwt === null || accessJwt === "") {
  return new Response(null, { status: 401 });
}

/** Mirrors the api's own UUID_RE: the only validation `noticeId` gets before it joins the api path below. */
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

markPrivate(Astro);
setPublicPageCsp(Astro);

let resendError: string | null = null;
let resendOk = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const noticeId = form.get("noticeId");
  if (typeof noticeId !== "string" || !UUID_RE.test(noticeId)) {
    resendError = "INVALID_NOTICE_ID";
  } else {
    const res = await adminApiFetch(`/admin/notices/${noticeId}/resend`, {
      method: "POST",
      accessJwt,
      origin: Astro.request.headers.get("Origin") ?? "",
    });
    if (res.status === 200) resendOk = true;
    else resendError = adminApiErrorCode(res) ?? "RESEND_FAILED";
  }
}

const resp = await adminApiFetch<AdminUndeliveredNoticesResponse>("/admin/notices/undelivered", { accessJwt });
const notices = resp.status === 200 && resp.data ? resp.data.notices : [];
const loadError = resp.status !== 200 ? (adminApiErrorCode(resp) ?? "NOTICES_LOAD_FAILED") : null;
---
<BaseLayout title="Undelivered notices">
  <div class="wrap admin-page">
    <h1>Undelivered notices</h1>
    <p class="admin-nav"><a class="link" href="/admin/queue">← Moderation queue</a></p>
    <p class="hint">
      These decisions are in force but the user was never emailed. Resend sends a fresh copy with a working appeal
      link; the appeal window starts when that copy is delivered. A reporter's notice cannot be resent (their address
      is not kept), and neither can one for an anonymised account.
    </p>
    {resendOk && <p class="ok">Queued for sending.</p>}
    {resendError && <p class="err">Resend failed: {resendError}</p>}
    {loadError && <p class="err">Could not load the notices: {loadError}</p>}
    {
      notices.length === 0 ? (
        <p id="no-items">Nothing undelivered.</p>
      ) : (
        <ul class="queue">
          {notices.map((n) => (
            <li class="queue-item">
              <p class="excerpt">{n.subject}</p>
              <p class="meta">
                {n.kind} · {n.recipientHandle ? `@${n.recipientHandle}` : "reporter (no account)"} · created{" "}
                {n.createdAt} · {n.attempts} attempts · {n.lastError ?? "no error recorded"} · purged {n.retainUntil}
              </p>
              {n.resendable ? (
                <form method="POST" class="resend-form">
                  <input type="hidden" name="noticeId" value={n.id} />
                  <button type="submit" class="btn btn-ghost">Resend</button>
                </form>
              ) : (
                <p class="orphan-flag">Cannot be resent.</p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
<style>
  .admin-page{padding:clamp(40px,7vw,80px) 0;max-width:760px}
  .admin-nav{margin:4px 0 20px}
  .hint{color:var(--muted);font-size:14px}
  .queue{list-style:none;display:flex;flex-direction:column;gap:20px;margin:24px 0}
  .queue-item{border:1px solid var(--line);border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:8px}
  .excerpt{margin:0}
  .meta{color:var(--muted);font-size:13px;margin:0}
  .orphan-flag{color:var(--muted);font-size:13px;margin:0}
  .err{color:var(--color-danger, #b91c1c)}
  .ok{color:var(--green)}
</style>
