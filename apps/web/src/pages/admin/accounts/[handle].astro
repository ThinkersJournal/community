---
/**
 * `/admin/accounts/:handle` — the enforcement ladder's account page (#113
 * plan A). Linked from `/admin/queue` (spec decision #3: content decision and
 * account action are separate, deliberate steps — this page is NOT reachable
 * from the queue's decision form). Same shape and same trust-boundary
 * properties as `/admin/queue.astro` and `/admin/media-access.astro` — see
 * those files' headers for the full reasoning.
 *
 * ⚠️⚠️ THE SAME PROPERTY AS THE QUEUE PAGE: no account content (a handle, a
 * suspension date, a history row) reaches the HTML on any request that does
 * not carry a verified Access JWT. The guard is the FIRST statement, before
 * markPrivate, before the CSP, before any api call.
 *
 * ⚠️ `terminate` is deliberately never offered here — it is the CSAM path
 * (#114), which calls the primitive itself and has no admin button.
 */
import BaseLayout from "../../../components/BaseLayout.astro";
import { adminApiErrorCode, adminApiFetch } from "../../../lib/admin-api";
import { markPrivate } from "../../../lib/cache";
import { setPublicPageCsp } from "../../../lib/csp";

import {
  ACCESS_JWT_HEADER,
  ADMIN_ACCOUNT_ACTIONS,
  DEFAULT_SUSPENSION_HOURS,
  LEGAL_HOLD_CATEGORIES,
  REPORT_REASONS,
  SUSPENSION_HOURS,
  type AdminAccountActionKind,
  type AdminAccountResponse,
} from "@thinkersjournal/shared";

// T3 impose never offers `csam` — CSAM holds come only from T1/T2, where
// there is evidence of the case (account-legal-hold spec §3 T3).
const MANUAL_HOLD_CATEGORIES = LEGAL_HOLD_CATEGORIES.filter((c) => c !== "csam");

// ⚠️⚠️ THE GUARD — see this file's header. Nothing above this line does
// anything; nothing below it may run when this returns.
const accessJwt = Astro.request.headers.get(ACCESS_JWT_HEADER);
if (accessJwt === null || accessJwt === "") {
  return new Response(null, { status: 401 });
}

markPrivate(Astro);
setPublicPageCsp(Astro);

const handle = Astro.params.handle ?? "";
let actionError: string | null = null;
let actionOk = false;
// A 200 that changed nothing (an impose of a category already actively held).
let actionNotice: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  const origin = Astro.request.headers.get("Origin") ?? "";

  if (intent === "hold_impose") {
    const res = await adminApiFetch<{ created: boolean }>(`/admin/accounts/${encodeURIComponent(handle)}/holds`, {
      method: "POST",
      accessJwt,
      origin,
      body: { category: form.get("category"), reason: form.get("reason") },
    });
    // `{ created: false }`: an active hold of this category already exists, so
    // nothing was imposed and nothing was logged (Review Focus 5). Say so,
    // rather than "Action recorded."
    if (res.status === 200 && res.data?.created === false) {
      actionNotice = `This account already has an active ${String(form.get("category"))} hold.`;
    } else if (res.status === 200) actionOk = true;
    else actionError = adminApiErrorCode(res) ?? "ACTION_FAILED";
  } else if (intent === "hold_release") {
    const holdId = form.get("holdId");
    const res = await adminApiFetch(`/admin/accounts/${encodeURIComponent(handle)}/holds/${encodeURIComponent(String(holdId))}/release`, {
      method: "POST",
      accessJwt,
      origin,
      body: { reason: form.get("reason") },
    });
    if (res.status === 200) actionOk = true;
    else actionError = adminApiErrorCode(res) ?? "ACTION_FAILED";
  } else {
    // "account_action" — unchanged body and path.
    const action = form.get("action");
    const res = await adminApiFetch(`/admin/accounts/${encodeURIComponent(handle)}/actions`, {
      method: "POST",
      accessJwt,
      origin,
      body: {
        action,
        reason: form.get("reason"),
        ...(form.get("violationCategory") ? { violationCategory: form.get("violationCategory") } : {}),
        ...(action === "suspend" ? { suspensionHours: Number(form.get("suspensionHours")) } : {}),
        ...(action === "ban" ? { confirmBan: form.get("confirmBan") === "on" } : {}),
      },
    });
    if (res.status === 200) actionOk = true;
    else actionError = adminApiErrorCode(res) ?? "ACTION_FAILED";
  }
}

const accountResp = await adminApiFetch<AdminAccountResponse>(`/admin/accounts/${encodeURIComponent(handle)}`, { accessJwt });
const account = accountResp.status === 200 ? accountResp.data : null;
const loadError = accountResp.status !== 200 ? (adminApiErrorCode(accountResp) ?? "ACCOUNT_LOAD_FAILED") : null;

function suspensionLabel(hours: number): string {
  if (hours === 24) return "24h";
  if (hours === 720) return "30 days";
  return "7 days";
}

/**
 * The account-state line (Review Focus 7). THREE disjoint states, not two:
 * a `disabledAt` is either the permanent ban rung or the CSAM `terminate`
 * path (#114 — never offered by this page's own form, but a moderator can
 * still be looking at an account terminated elsewhere), and a `suspendedUntil`
 * in the past is a LAPSED suspension, not a current one — the account is free,
 * and saying "Suspended until <past date>" would read as still in force.
 */
function stateLine(account: AdminAccountResponse): string {
  if (account.disabledAt) {
    return account.disabledReason === "terminate"
      ? `Terminated (CSAM path) since ${account.disabledAt}`
      : `Banned since ${account.disabledAt}`;
  }
  if (account.suspendedUntil) {
    return new Date(account.suspendedUntil).getTime() <= Date.now()
      ? `Suspension ended ${account.suspendedUntil}`
      : `Suspended until ${account.suspendedUntil}`;
  }
  return "In good standing";
}
---
<BaseLayout title={`Account — ${handle}`}>
  <div class="wrap admin-page">
    <h1>Account — @{handle}</h1>
    <p class="admin-nav"><a class="link" href="/admin/queue">← Moderation queue</a></p>
    {actionError && <p class="err">Action failed: {actionError}</p>}
    {actionOk && <p class="ok">Action recorded.</p>}
    {actionNotice && <p class="notice">{actionNotice}</p>}
    {loadError && <p class="err">Could not load the account: {loadError}</p>}
    {
      account && (
        <>
          <p class="state">{stateLine(account)}</p>
          {!account.disabledAt && (
            <p class="suggested">Suggested next step: {account.suggestedNext} (advisory)</p>
          )}

          <h2>History</h2>
          {
            account.history.length === 0 ? (
              <p id="no-history">No prior actions.</p>
            ) : (
              <ul class="history">
                {account.history.map((h) => (
                  <li class="history-item">
                    <p class="action">{h.action}</p>
                    <p class="meta">
                      {h.createdAt} · {h.reason} ·{" "}
                      {h.countsTowardEscalation ? "counts toward escalation" : "older than 12 months"}
                    </p>
                  </li>
                ))}
              </ul>
            )
          }

          {
            account.disabledAt ? (
              <p class="banned">This account is banned.</p>
            ) : (
              <form method="POST" class="action-form">
                <input type="hidden" name="intent" value="account_action" />
                <label>
                  Statement of reasons (shown to the user)
                  <textarea name="reason" required maxlength="2000" />
                </label>
                <label>
                  Violation category (optional)
                  <select name="violationCategory">
                    <option value="">—</option>
                    {REPORT_REASONS.map((cat) => (
                      <option value={cat}>{cat}</option>
                    ))}
                  </select>
                </label>
                <label>
                  Suspension duration
                  <select name="suspensionHours">
                    {SUSPENSION_HOURS.map((hrs) => (
                      <option value={hrs} selected={hrs === DEFAULT_SUSPENSION_HOURS}>
                        {suspensionLabel(hrs)}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="confirm-ban">
                  <input type="checkbox" name="confirmBan" />
                  I confirm a permanent ban
                </label>
                <div class="action-buttons">
                  {ADMIN_ACCOUNT_ACTIONS.map((a: AdminAccountActionKind) => (
                    <button type="submit" name="action" value={a} class="btn btn-ghost">
                      {a}
                    </button>
                  ))}
                </div>
              </form>
            )
          }

          <section class="holds">
            <h2>Legal holds</h2>
            {
              account.holds.length === 0 ? (
                <p id="no-holds">No holds on record.</p>
              ) : (
                <ul class="holds-list">
                  {account.holds.map((hold) => (
                    <li class="hold-item">
                      <p class="category">{hold.category}</p>
                      <p class="meta">
                        {hold.reason} · imposed by {hold.imposedBy} at {hold.imposedAt}
                      </p>
                      {
                        hold.releasedAt ? (
                          <p class="released">
                            Released by {hold.releasedBy} at {hold.releasedAt}: {hold.releaseReason}
                          </p>
                        ) : hold.category === "csam" ? (
                          <p class="csam-note">(cannot be released in the app)</p>
                        ) : (
                          <form method="POST" class="hold-release-form">
                            <input type="hidden" name="intent" value="hold_release" />
                            <input type="hidden" name="holdId" value={hold.id} />
                            <label>
                              Release reason
                              <textarea name="reason" required maxlength="2000" />
                            </label>
                            <button type="submit" class="btn btn-ghost">Release hold</button>
                          </form>
                        )
                      }
                    </li>
                  ))}
                </ul>
              )
            }

            <form method="POST" class="hold-impose-form">
              <input type="hidden" name="intent" value="hold_impose" />
              <label>
                Category
                <select name="category">
                  {MANUAL_HOLD_CATEGORIES.map((cat) => (
                    <option value={cat}>{cat}</option>
                  ))}
                </select>
              </label>
              <label>
                Reason
                <textarea name="reason" required maxlength="2000" />
              </label>
              <button type="submit" class="btn btn-ghost">Impose hold</button>
            </form>
          </section>
        </>
      )
    }
  </div>
</BaseLayout>
<style>
  .admin-page{padding:clamp(40px,7vw,80px) 0}
  .admin-nav{margin:4px 0 20px}
  .err{color:var(--red, #e5484d)}
  .ok{color:var(--green)}
  .state{font-weight:600}
  .suggested{color:var(--muted);font-size:14px;margin-bottom:24px}
  .history{list-style:none;display:flex;flex-direction:column;gap:12px;margin:12px 0 32px}
  .history-item{border:1px solid var(--line);border-radius:8px;padding:12px}
  .history-item .action{font-weight:600}
  .history-item .meta{color:var(--muted);font-size:13px;margin-top:4px}
  .banned{color:var(--muted);font-style:italic}
  .action-form{display:flex;flex-direction:column;gap:10px;max-width:480px;margin:20px 0 32px;
    padding:16px;border:1px solid var(--line);border-radius:8px}
  .action-form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .action-form label.confirm-ban{flex-direction:row;align-items:center;gap:8px}
  .action-form input,.action-form textarea,.action-form select{background:var(--ink2);border:1px solid var(--line);
    border-radius:8px;padding:9px 11px;color:var(--text);font:inherit}
  .action-buttons{display:flex;gap:10px;flex-wrap:wrap}
  .holds{margin:20px 0 32px}
  .holds-list{list-style:none;display:flex;flex-direction:column;gap:12px;margin:12px 0 20px}
  .hold-item{border:1px solid var(--line);border-radius:8px;padding:12px}
  .hold-item .category{font-weight:600;text-transform:uppercase;font-size:12px}
  .hold-item .meta{color:var(--muted);font-size:13px;margin-top:4px}
  .hold-item .released{color:var(--muted);font-size:13px;margin-top:8px}
  .hold-item .csam-note{color:var(--muted);font-style:italic;font-size:13px;margin-top:8px}
  .hold-release-form,.hold-impose-form{display:flex;flex-direction:column;gap:10px;max-width:480px;margin-top:8px}
  .hold-release-form label,.hold-impose-form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .hold-release-form input,.hold-release-form textarea,.hold-release-form select,
  .hold-impose-form input,.hold-impose-form textarea,.hold-impose-form select{
    background:var(--ink2);border:1px solid var(--line);border-radius:8px;padding:9px 11px;color:var(--text);font:inherit}
</style>
