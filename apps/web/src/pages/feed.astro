---
/**
 * `GET /feed` — the signed-in viewer's home feed, keyset-paginated via
 * `?cursor=`.
 *
 * ⚠️ Per-viewer, uncached (markPrivate below): the api's `/feed` response
 * depends on who the viewer follows, so nothing here may ever reach the
 * Workers Cache.
 */
import BaseLayout from "../components/BaseLayout.astro";
import { apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

import type { Feed } from "@thinkersjournal/shared";

// Per-viewer, uncached.
markPrivate(Astro);

// Now carries the shared nav island + fonts (BaseLayout, below). No inline
// `<script>` on this page, so `script-src 'self'` (setPublicPageCsp's policy)
// is safe.
setPublicPageCsp(Astro);

const cursor = Astro.url.searchParams.get("cursor");

const response = await apiFetch<Feed>(
  cursor === null ? "/feed" : `/feed?cursor=${encodeURIComponent(cursor)}`,
  { request: Astro.request },
);

// No session (or a stale one) → the api answered 401.
//
// ⚠️ DO NOT REPLACE THIS WITH `Astro.redirect("/login")`. That helper builds
// a Response it owns ITSELF, which does not carry `Astro.response.headers`
// — so the api's `Set-Cookie` on this very 401 (a stale/expired session can
// be CLEARED on this reachable path) would be silently dropped, leaving a
// cleared-but-still-present cookie on the browser. Same bug class login.astro's
// headers document at length; the fix is identical — build the redirect by
// hand and apply cookies to IT.
if (response.status === 401) {
  const redirect = new Response(null, {
    status: 302,
    headers: { Location: "/login" },
  });
  applyCookies(redirect.headers, response.setCookies);
  return redirect;
}

// Any other outcome renders THIS page, so `Astro.response` IS the outgoing
// response — propagate whatever cookie the api sent (if any) onto it.
applyCookies(Astro.response.headers, response.setCookies);

const feed: Feed = response.data ?? { posts: [], nextCursor: null };
---

<BaseLayout title="Your feed">
  <div class="wrap feed">
    <h1>Your feed</h1>
    {feed.posts.length === 0 ? (
      <p>Your feed is empty. <a class="link" href="/authors">Discover authors to follow →</a> or <a class="link" href="/">browse Discover →</a></p>
    ) : (
      <ul class="cards">
        {feed.posts.map((post) => (
          <li class="card">
            <h2><a href={`/@${post.username}/${post.slug}`}>{post.title}</a></h2>
            <p class="meta">by <a class="link" href={`/@${post.username}`}>@{post.username}</a> · <time datetime={post.publishedAt}>{post.publishedAt.slice(0, 10)}</time></p>
            <p>{post.excerptSource.slice(0, 200)}</p>
            {/* Freeform tags (M2.4c). encodeURIComponent on the slug — a URL
                needs percent-encoding (unlike this page's other links above,
                which are not encoded); the label is an Astro `{}` expression
                (escaped), never set:html. */}
            {post.tags.length > 0 && (
              <ul class="tags">
                {post.tags.map((t) => (
                  <li><a class="tag" href={`/tag/${encodeURIComponent(t.slug)}`}>{t.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
    {feed.nextCursor !== null && (
      <a class="link" rel="next" href={`/feed?cursor=${encodeURIComponent(feed.nextCursor)}`}>Older posts →</a>
    )}
  </div>
</BaseLayout>
<style>
  .feed{padding:clamp(40px,7vw,80px) 0}
  .cards{list-style:none;display:flex;flex-direction:column;gap:28px;margin:28px 0}
  .card{border:1px solid var(--line);border-radius:12px;padding:22px;background:var(--ink2)}
  .card h2{font-size:22px;margin-bottom:6px}
  .card .meta{color:var(--dim);font-size:14px;margin-bottom:10px}
  .tags{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 0;padding:0}
  .tags .tag{font-size:12px;color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:2px 9px;text-decoration:none}
  .tags .tag:hover{color:var(--head)}
</style>
