---
/**
 * `POST /auth/signup` through the Service Binding.
 *
 * The form posts back to THIS page (same-origin), and this component forwards
 * to the api. Doing it server-side rather than with client `fetch` is what
 * keeps the api unreachable from the browser at all.
 */
import BaseLayout from "../components/BaseLayout.astro";
import { apiErrorCode, apiFetch, applyCookies } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

// ⚠️ Per-viewer: signup is where a session first comes to exist — the api's
// `Set-Cookie` rides out on this very response. Cookie is NOT in the Workers
// Cache key and does NOT trigger a bypass, so a cacheable render here would
// serve one signup's outcome to every later visitor. See src/lib/cache.ts.
markPrivate(Astro);

// Carries the shared nav island + fonts (BaseLayout, below) and the Turnstile
// widget. `{ turnstile: true }` widens THIS page's CSP to allow Turnstile's host
// (script-/connect-/frame-src) — see src/lib/csp.ts. Still no INLINE script: the
// api.js is external, so no 'unsafe-inline' is needed and the property that file
// exists for holds.
setPublicPageCsp(Astro, { turnstile: true });

/** Rendered outcome. `null` = first visit, nothing submitted yet. */
let result: "created" | "error" | null = null;
let message = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const response = await apiFetch<{ code?: string; message?: string; suggestions?: string[] }>(
    "/auth/signup",
    {
      method: "POST",
      // The api validates all four with zod and 400s on anything malformed —
      // no client-side validation here on purpose (it would only ever be a
      // duplicate of the real check, and a bypassable one).
      body: {
        username: form.get("username"),
        email: form.get("email"),
        password: form.get("password"),
        turnstileToken: form.get("turnstileToken"),
      },
      // ⚠️ The BROWSER's Origin, forwarded verbatim — never this app's own.
      // Like login, signup has no session yet and so no double-submit token:
      // `checkOrigin` is its ENTIRE CSRF defense. Substituting our own
      // (always-allowlisted) origin would launder a cross-site request and let
      // evil.com drive signups in a victim's browser. A Service-Binding request
      // carries no Origin of its own, so this must be passed explicitly; an
      // empty string is fine (the api falls back to Referer, then fails closed).
      origin: Astro.request.headers.get("Origin") ?? "",
      // No `request`/cookie: signup is how a session first comes to exist.
    },
  );

  // ⚠️ The api mints the session cookie on 201. Without this the user would be
  // signed up but not logged in.
  applyCookies(Astro.response.headers, response.setCookies);

  if (response.status === 201) {
    result = "created";
  } else {
    result = "error";
    // 409 now has TWO causes (handle-at-signup): an already-registered,
    // VERIFIED email (EMAIL_TAKEN — safe to say so, it reveals nothing that
    // attempting a login would not) and a handle collision (USERNAME_TAKEN,
    // checked first, below). Branch on `code`, never on status alone.
    if (apiErrorCode(response) === "USERNAME_TAKEN") {
      // Suggestions are advisory plain text — no client JS involved, just
      // server-rendered into the existing #error block below.
      const suggestions = response.data?.suggestions ?? [];
      message = suggestions.length
        ? `That handle is taken. Available: ${suggestions.map((h) => "@" + h).join(", ")}.`
        : "That handle is taken — please choose another.";
    } else if (response.status === 400 && response.data?.message) {
      // Of the two 400 causes, only the RESERVED handle carries a `message`
      // (apps/api/src/routes/signup.ts:99-104) — a static, non-reflective
      // string safe to surface verbatim (see that route's comment at
      // signup.ts:88-89). The plain zod bad-format 400 has no `message`, so
      // it falls through to the generic copy below rather than showing
      // nothing meaningful.
      message = response.data.message;
    } else {
      message =
        response.status === 409
          ? "That email is already registered. Try logging in."
          : response.status === 429
            ? "Too many attempts. Please wait and try again."
            : response.status === 403
              ? "Rejected (failed bot check)."
              : "Signup failed. Check your email and password and try again.";
    }
  }
}
---

<BaseLayout title="Sign up" description="Create your Thinker's Journal account.">
  <div class="wrap form-page">
    <h1>Sign up</h1>

    {
      result === "created" ? (
        <p id="check-email">
          Check your email — we sent you a verification link.
        </p>
      ) : (
        <>
          {result === "error" && <p id="error" role="alert">{message}</p>}
          <form method="POST" class="form">
            <label>
              Handle
              <input type="text" name="username" required minlength="3" maxlength="30"
                     pattern="[A-Za-z0-9_]+" title="3–30 letters, numbers, or _ (automatically lowercased)" />
              <small>Your @handle is permanent — choose carefully.</small>
            </label>
            <label>
              Email
              <input type="email" name="email" required />
            </label>
            <label>
              Password
              <input type="password" name="password" required />
            </label>
            {/*
              Cloudflare Turnstile. The external api.js (below — allowed by the
              signup-only CSP addition in src/lib/csp.ts) renders the challenge
              and, via `data-response-field-name`, injects the hidden
              `turnstileToken` field the api reads (routes/signup.ts →
              auth/turnstile.ts's siteverify). The site key is PUBLIC by design;
              the SECRET half lives only in the api's TURNSTILE_SECRET_KEY.
            */}
            <div
              class="cf-turnstile"
              data-sitekey="0x4AAAAAAEeHIE7gGXEOrrpY"
              data-response-field-name="turnstileToken"
            ></div>
            <button type="submit" class="btn btn-primary">Sign up</button>
          </form>
          {/*
            NO Subresource Integrity, deliberately. Turnstile's api.js is a
            Cloudflare-updated LOADER (versionless by design), so a pinned
            `integrity` hash would break the widget the moment they update it —
            Cloudflare does not support SRI on it. The integrity control here is
            instead the CSP: script-src is allowlisted to challenges.cloudflare.com
            only (src/lib/csp.ts's signup policy), so nothing else can load.
          */}
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )
    }

    <p><a class="link" href="/login">Already have an account? Log in</a></p>
  </div>
</BaseLayout>
<style>
  .form-page{padding:clamp(40px,7vw,80px) 0;max-width:440px}
  .form{display:flex;flex-direction:column;gap:16px;margin:24px 0}
  .form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:14px}
  .form input{background:var(--ink2);border:1px solid var(--line);border-radius:8px;
    padding:11px 13px;color:var(--text);font:inherit}
  .form input:focus-visible{border-color:var(--green)}
</style>
