---
/**
 * #78 — THE OWNER-VISIBLE FALLBACK RENDER. Split out of `[handle]/[slug].astro`
 * itself so that file keeps a single, textually-obvious cache declaration
 * (`markPublicCacheable`) for SWEEP A (test/page-cache-inventory.test.ts) —
 * SWEEP A only scans `src/pages`, so this component carrying `markPrivate`
 * does not create a second helper name in the page file. This is not a
 * workaround: SWEEP A's OWN intent is "the page's cache posture must be
 * visible in one place with no ambiguity", and a component whose entire job
 * is "render the private owner view" is exactly that — moving the private
 * declaration here makes it structurally impossible for the wrong helper to
 * ever end up mixed into the public branch.
 *
 * ⚠️ SECURITY-CRITICAL (PM review condition 3): `markPrivate` below is the one
 * line standing between a hidden/draft post and #61's exact failure one layer
 * up. This is the ONLY place this component may declare cacheability — no
 * `markPublicCacheable` anywhere in this file. Pinned by
 * test/post-page-owner-fallback.test.ts.
 */
import { renderMarkdown } from "@thinkersjournal/markdown";

import { apiFetch } from "../lib/api";
import { markPrivate } from "../lib/cache";
import { setPublicPageCsp } from "../lib/csp";

import BaseLayout from "./BaseLayout.astro";

import type { AuthoredPost } from "@thinkersjournal/shared";

interface Props {
  post: AuthoredPost;
}
const { post: ownerPost } = Astro.props;

markPrivate(Astro);
setPublicPageCsp(Astro);

const html = await renderMarkdown(ownerPost.markdownSource);

// Hide/Unhide CSRF — same idiom as new-post.astro. This render is ALREADY
// authenticated as the owner (this component is only ever rendered for the
// real author), so it needs no client-side owner-detection, and it reuses
// scripts/post-visibility.ts (both directions), not post-visibility-view.ts
// (hide-only, built for the anonymous branch where a hidden post never even
// renders).
const csrf = await apiFetch<{ csrfToken: string }>("/auth/csrf", { request: Astro.request });
const ownerCsrfToken = csrf.status === 200 ? (csrf.data?.csrfToken ?? null) : null;
---

<BaseLayout title={ownerPost.title}>
  <article class="wrap post owner-view">
    <h1>{ownerPost.title}</h1>

    {/* #82 — banner and the Hide/Unhide toolbar grouped TOGETHER, right after
        the heading, instead of the heading sitting between them (the
        reported "two pieces of the same concern split across the heading").
        Same relative position as [handle]/[slug].astro's public branch:
        heading, then the owner's status/actions cluster, then content. */}
    <div class="owner-status">
      {ownerPost.hiddenAt !== null ? (
        <p id="hidden-owner-banner" role="status">
          <strong>This post is hidden.</strong>{" "}
          {ownerPost.hiddenReason === "author"
            ? "You hid it. It is not visible to anyone else."
            : "It is not visible to anyone else, following a moderation review or a report about it."}
        </p>
      ) : (
        <p id="draft-owner-banner" role="status">
          <strong>This is a draft.</strong> It has not been published, so it is not visible to anyone else.
        </p>
      )}

      {/* Only for a PUBLISHED post: a draft has nothing to hide/unhide. Unhide
          gated on hiddenReason === 'author' (PM review note (a)) — a UI gate
          only; POST /posts/:id/unhide still re-derives this itself and is the
          actual authority (403 POST_UNDER_MODERATION otherwise, which the
          script surfaces if this gate is ever wrong). */}
      {ownerPost.status === "published" && ownerCsrfToken !== null && (
        <div class="visibility-zone" data-post-visibility data-post-id={ownerPost.id} data-csrf-token={ownerCsrfToken}>
          <button type="button" class="btn btn-ghost" data-hide-btn hidden={ownerPost.hiddenAt !== null}>
            Hide post
          </button>
          <button
            type="button"
            class="btn btn-ghost"
            data-unhide-btn
            hidden={!(ownerPost.hiddenAt !== null && ownerPost.hiddenReason === "author")}
          >
            Unhide post
          </button>
          <p class="visibility-error" data-visibility-error hidden />
        </div>
      )}
    </div>

    {ownerPost.tags.length > 0 && (
      <ul class="tags">
        {ownerPost.tags.map((t) => (
          <li><a class="tag" href={`/tag/${encodeURIComponent(t.slug)}`}>{t.label}</a></li>
        ))}
      </ul>
    )}
    <div id="post-body" set:html={html} />

    <p class="owner-view-edit"><a class="link" href={`/new-post?post=${encodeURIComponent(ownerPost.id)}`}>Edit this post</a></p>
  </article>

  <script>
    import { initPostVisibility } from "../scripts/post-visibility";
    initPostVisibility();
  </script>
</BaseLayout>

<style>
  /* #82 — banner + Hide/Unhide grouped as one cluster, clearly separated
     from the heading above (margin-top) and the body below (margin-bottom),
     instead of the heading splitting them. */
  .owner-status{margin:20px 0 28px}
  .owner-view #hidden-owner-banner,.owner-view #draft-owner-banner{border-left:3px solid var(--color-warning, #b45309);padding-left:.75rem;margin-bottom:14px}
  .owner-view-edit{margin-top:24px}
  .visibility-zone{display:flex;align-items:center;gap:10px}
  .visibility-zone [hidden]{display:none}
  .tags{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 0;padding:0}
  .tags .tag{font-size:12px;color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:2px 9px;text-decoration:none}
  .tags .tag:hover{color:var(--head)}
  #post-body{line-height:1.7}
  #post-body :global(h2),#post-body :global(h3){margin:1.6em 0 .5em}
  #post-body :global(p){margin:0 0 1em}
  #post-body :global(pre){background:var(--ink2);border:1px solid var(--line);
    border-radius:10px;padding:16px;overflow-x:auto;margin:1.2em 0}
  #post-body :global(a){color:var(--green)}
</style>
