---
/**
 * Shared header for the three settings subpages (notifications/blocked/account)
 * and the /settings landing page. Gives the three subpages a "← Settings"
 * back-link plus a tab-style list of the three sections, replacing the ad-hoc
 * cross-links each page used to hand-roll (one per page, inconsistent
 * order/wording). The landing page itself must not link to /settings from
 * /settings, so the back-link renders ONLY when `current` is set (the
 * subpages always pass it; the landing page omits it).
 *
 * Accessibility: a <nav aria-label="Settings"> landmark around a real <ul> of
 * links, `aria-current="page"` on the active tab, DOM order == visual order,
 * and focus comes from the site's global :focus-visible (no local override).
 */
export interface Props { current?: "notifications" | "blocked" | "account" }
const { current } = Astro.props;

const SECTIONS = [
  { key: "notifications", href: "/settings/notifications", label: "Notification emails" },
  { key: "blocked", href: "/settings/blocked", label: "Blocked users" },
  { key: "account", href: "/settings/account", label: "Account" },
] as const;
---
<div class="settings-nav">
  {current !== undefined && <a class="link back" href="/settings">← Settings</a>}
  <nav aria-label="Settings">
    <ul class="tabs">
      {SECTIONS.map((s) => (
        <li>
          <a href={s.href} aria-current={current === s.key ? "page" : undefined}>{s.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>
<style>
  .settings-nav{display:flex;flex-direction:column;gap:12px;margin:4px 0 24px}
  .back{align-self:flex-start}
  .tabs{list-style:none;display:flex;flex-wrap:wrap;gap:8px;row-gap:8px}
  .tabs a{display:inline-block;padding:9px 16px;border-radius:999px;font-size:14px;
    color:var(--muted);border:1px solid var(--line)}
  .tabs a:hover{color:var(--text)}
  .tabs a[aria-current="page"]{color:var(--on-green);background:var(--green);border-color:var(--green)}
  @media(max-width:480px){
    .tabs{flex-direction:column;align-items:stretch}
    .tabs a{text-align:center}
  }
</style>
