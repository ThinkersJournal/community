# PROVES: Task 1 (write-up section 1): socket activation that lets the service run with PrivateNetwork=yes.
# INPUTS: unit file; copied to /etc/systemd/system by setup.sh and lib.sh sync_files.
# EFFECTS: once started (start_case does this) it OPENS A TCP LISTENER on 127.0.0.1:8088 (loopback only) in the distro and passes it to tj-wrapper.service. Nothing here
#   stops or kills anything.
# BENIGN: it issues no docker, wsl or host-level kill/stop/prune command; run only inside a throwaway environment you created yourself (pass 2: a throwaway WSL2 distro;
#   c8.py: a container named tjspike2-pdq or similar tjspike* name). (This file is configuration only.)
# ARCHIVED: preserved verbatim from the spike session, path variables parameterised only.
[Unit]
Description=TJ decoder socket (spike harness)

[Socket]
ListenStream=127.0.0.1:8088
Accept=no
