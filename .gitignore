# Dependencies
node_modules/

# Build output
dist/
.astro/
.output/
build/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*

# Env & secrets
.env
.env.*
!.env.example

# Test artifacts
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Brainstorm/SDD scratch (session-local; contains keys)
/.superpowers/

# Agent tooling (session-local), ignored so a stray `git add -A` can't land it.
# `supertool` here is a ~540KB executable binary (not source). `.claude`/`.serena`
# are agent state dirs (elsewhere embedded git repos, which would commit as
# broken gitlinks).
/supertool
/.claude/
/.serena/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
